                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_SIDE"
                    }
                  }
                }
              }
            ]
          },
          {
            "height": 19,
            "widgets": [
              {
                "title": "Failed outbound gRPC calls (caller \u2192 method, per s)",
                "description": "Client-side view: which service saw which dependency fail",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "failed",
                        "seriesNameTemplate": "{{service_name}} \u2192 {{span_name}}",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum by (service_name, span_name) (rate(calls_total{span_kind=\"SPAN_KIND_CLIENT\", span_name=~\"oteldemo[.].+Service/.+\", status_code=\"STATUS_CODE_ERROR\"}[5m]))"
                          }
                        }
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_BOTTOM"
                    }
                  }
                }
              },
              {
                "title": "Busiest methods (calls, last hour)",
                "definition": {
                  "horizontalBarChart": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "sum by (span_name) (increase(calls_total{span_kind=\"SPAN_KIND_SERVER\", span_name=~\"oteldemo[.].+Service/.+\"}[1h]))",
                        "promqlQueryType": "PROM_QL_QUERY_TYPE_INSTANT",
                        "aggregation": "AGGREGATION_LAST",
                        "groupNames": [
                          "span_name"
                        ]
                      }
                    },
                    "sortBy": "SORT_BY_TYPE_VALUE",
                    "maxBarsPerChart": 12
                  }
                }
              },
              {
                "title": "Slowest methods (p95, last hour)",
                "definition": {
                  "horizontalBarChart": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "histogram_quantile(0.95, sum by (span_name, le) (increase(duration_ms_bucket{span_kind=\"SPAN_KIND_SERVER\", span_name=~\"oteldemo[.].+Service/.+\"}[1h])))",
                        "promqlQueryType": "PROM_QL_QUERY_TYPE_INSTANT",
                        "aggregation": "AGGREGATION_LAST",
                        "groupNames": [
                          "span_name"
                        ]
                      }
                    },
                    "sortBy": "SORT_BY_TYPE_VALUE",
                    "maxBarsPerChart": 12
                  }
                }
              }
            ]
          },
          {
            "height": 19,
            "widgets": [
              {
                "title": "gRPC message size: AdService/GetAds (only instrumented service)",
                "description": "Only the Java agent (ad) records gRPC message sizes; the Go, .NET, Node, Python and C++ SDKs in this demo don't. Edge HTTP sizes above cover all browser/API traffic.",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "request",
                        "seriesNameTemplate": "request (avg)",
                        "unit": "UNIT_BYTES_IEC",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum(rate(rpc_server_request_size_By_sum{rpc_service=\"oteldemo.AdService\"}[5m])) / sum(rate(rpc_server_request_size_By_count{rpc_service=\"oteldemo.AdService\"}[5m]))"
                          }
                        }
                      },
                      {
                        "name": "response",
                        "seriesNameTemplate": "response (avg)",
                        "unit": "UNIT_BYTES_IEC",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum(rate(rpc_server_response_size_By_sum{rpc_service=\"oteldemo.AdService\"}[5m])) / sum(rate(rpc_server_response_size_By_count{rpc_service=\"oteldemo.AdService\"}[5m]))"
                          }
                        }
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_BOTTOM"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
