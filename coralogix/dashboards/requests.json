                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "sum(rate(calls_total{span_kind=\"SPAN_KIND_SERVER\", span_name=~\"oteldemo[.].+Service/.+\"}[15m]))",
                        "aggregation": "AGGREGATION_LAST"
