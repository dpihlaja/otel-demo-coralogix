{
  "id": "EpGYoQkqLthy2FpVZJ2Y4",
  "name": "Requests",
  "description": "Do calls succeed, and how fast? Synchronous HTTP and gRPC calls, by the four signals. Edge HTTP comes from Envoy access logs (proxy_requests Events2Metric, includes request/response bytes); service-level HTTP and gRPC come from span metrics (100% of calls, before trace sampling). gRPC methods are normalized in the collector to 'oteldemo.<Service>/<Method>' whatever the SDK.",
  "relativeTimeFrame": "10800s",
  "autoRefresh": "one_minute",
  "layout": {
    "sections": [
      {
        "options": {
          "name": "Four signals (last 15 min)",
          "description": "Left to right: errors, latency, saturation, throughput. Top row: the edge, what browsers and API clients see at the proxy. Bottom row: gRPC calls between backend services (no saturation tile: the SDKs report no in-flight or queue metrics).",
          "color": "SECTION_PREDEFINED_COLOR_GREEN"
        },
        "rows": [
          {
            "height": 12,
            "widgets": [
              {
                "title": "Errors \u00b7 Edge 5xx rate",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "(sum(sum_over_time(proxy_requests_cx_docs_total{status_code=~\"5..\"}[15m])) or vector(0)) / sum(sum_over_time(proxy_requests_cx_docs_total[15m]))",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
                    "max": 0.1,
                    "unit": "UNIT_PERCENT_ZERO_ONE",
                    "decimal": 2,
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "thresholdBy": "THRESHOLD_BY_BACKGROUND",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "green"
                      },
                      {
                        "from": 0.005,
                        "color": "orange"
                      },
                      {
                        "from": 0.02,
                        "color": "red"
                      }
                    ],
                    "arcDisplay": {
                      "valueArc": false,
                      "thresholdArc": false
                    },
                    "displaySeriesName": false
                  }
                }
              },
              {
                "title": "Latency \u00b7 Edge p95",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "histogram_quantile(0.95, sum by (le) (sum_over_time(proxy_duration_ms_cx_bucket{route!~\".*EventStream\"}[15m])))",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
                    "max": 5000,
                    "unit": "UNIT_MILLISECONDS",
                    "decimal": 0,
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "thresholdBy": "THRESHOLD_BY_BACKGROUND",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "green"
                      },
                      {
                        "from": 1000,
                        "color": "orange"
                      },
                      {
                        "from": 3000,
                        "color": "red"
                      }
                    ],
                    "arcDisplay": {
                      "valueArc": false,
                      "thresholdArc": false
                    },
                    "displaySeriesName": false
                  }
                }
              },
              {
                "title": "Saturation \u00b7 Edge upstream timeouts and failures",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "(sum(sum_over_time(proxy_requests_cx_docs_total{response_flags=~\".*(UT|UF|UC|UO|URX).*\"}[15m])) or vector(0)) / sum(sum_over_time(proxy_requests_cx_docs_total[15m]))",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
                    "max": 0.05,
                    "unit": "UNIT_PERCENT_ZERO_ONE",
                    "decimal": 2,
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "thresholdBy": "THRESHOLD_BY_BACKGROUND",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "green"
                      },
                      {
                        "from": 0.001,
                        "color": "orange"
                      },
                      {
                        "from": 0.01,
                        "color": "red"
                      }
                    ],
                    "arcDisplay": {
                      "valueArc": false,
                      "thresholdArc": false
                    },
                    "displaySeriesName": false
                  }
                },
                "description": "Share of edge requests Envoy flagged UT (upstream timeout), UF (connect failure), UC (connection reset), UO (overflow) or URX (retries exhausted): backends that can't keep up"
              },
              {
                "title": "Throughput \u00b7 Edge requests/s",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "sum(sum_over_time(proxy_requests_cx_docs_total[15m])) / 900",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
                    "max": 100,
                    "unit": "UNIT_NUMBER",
                    "decimal": 1,
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "thresholdBy": "THRESHOLD_BY_BACKGROUND",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "green"
                      }
                    ],
                    "arcDisplay": {
                      "valueArc": false,
                      "thresholdArc": false
                    },
                    "displaySeriesName": false
                  }
                }
              }
            ]
          },
          {
            "height": 12,
            "widgets": [
