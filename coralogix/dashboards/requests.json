              {
                "title": "Latency \u00b7 gRPC p95",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "histogram_quantile(0.95, sum by (le) (rate(duration_ms_bucket{span_kind=\"SPAN_KIND_SERVER\", span_name=~\"oteldemo[.].+Service/.+\"}[15m])))",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
