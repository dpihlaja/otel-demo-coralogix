          }
        ]
      },
      {
        "options": {
          "name": "HTTP at the edge (Envoy access logs)",
          "description": "Every request through frontend-proxy, from the parsed Envoy access log. Routes are normalized (no product IDs or query strings). response_flags is Envoy's own failure reason: UT upstream timeout, UF upstream connect failure, URX retry limit, DC client disconnect, DI injected delay. Latency panels leave out flagd's EventStream: a 10-minute streaming connection, not a slow request.",
          "color": "SECTION_PREDEFINED_COLOR_BLUE"
        },
        "rows": [
          {
            "height": 19,
            "widgets": [
              {
                "title": "Requests/s by route (top 10)",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "requests",
                        "seriesNameTemplate": "{{route}}",
                        "query": {
                          "metrics": {
                            "promqlQuery": "topk(10, sum by (route) (sum_over_time(proxy_requests_cx_docs_total[5m]))) / 300"
                          }
                        }
                      }
                    ],
                    "stackedLine": "STACKED_LINE_ABSOLUTE",
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_AVG"
                      ],
                      "placement": "LEGEND_PLACEMENT_SIDE"
                    }
                  }
                }
              },
              {
                "title": "Responses/s by status code",
