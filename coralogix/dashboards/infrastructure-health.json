{
  "id": "qzoR6PmYBR2f9ZqFJkP13",
  "name": "Infrastructure health",
  "description": "Is the cluster healthy, and if not, which workload is under pressure? Kubernetes (kubelet, cluster, cAdvisor), node host metrics, the Coralogix telemetry pipeline itself, and Kafka.",
  "relativeTimeFrame": "3600s",
  "autoRefresh": "one_minute",
  "layout": {
    "sections": [
      {
        "options": {
          "name": "Cluster at a glance",
          "description": "Green = nothing to do. Any amber/red tile tells you which section below to open.",
          "color": "SECTION_PREDEFINED_COLOR_GREEN"
        },
        "rows": [
          {
            "height": 12,
            "widgets": [
              {
                "title": "Node ready",
                "description": "k8s_node_condition_ready (1 = Ready)",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "min(k8s_node_condition_ready)",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
                    "max": 1,
                    "unit": "UNIT_NUMBER",
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "thresholdBy": "THRESHOLD_BY_BACKGROUND",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "red",
                        "label": "not ready"
                      },
                      {
                        "from": 1,
                        "color": "green",
                        "label": "ready"
                      }
                    ],
                    "arcDisplay": {
                      "valueArc": false,
                      "thresholdArc": false
                    },
                    "displaySeriesName": false
                  }
                }
              },
              {
                "title": "Unavailable replicas",
                "description": "Desired minus available pods across all deployments",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "sum(k8s_deployment_desired__pod_ - k8s_deployment_available__pod_)",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
                    "max": 5,
                    "unit": "UNIT_NUMBER",
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "thresholdBy": "THRESHOLD_BY_BACKGROUND",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "green"
                      },
                      {
                        "from": 1,
                        "color": "red"
                      }
                    ],
                    "arcDisplay": {
                      "valueArc": false,
                      "thresholdArc": false
                    },
                    "displaySeriesName": false
                  }
                }
              },
              {
                "title": "Containers not ready",
                "description": "Containers failing their readiness probe",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "count(k8s_container_ready == 0) or vector(0)",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
                    "max": 5,
                    "unit": "UNIT_NUMBER",
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "thresholdBy": "THRESHOLD_BY_BACKGROUND",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "green"
                      },
                      {
                        "from": 1,
                        "color": "red"
                      }
                    ],
                    "arcDisplay": {
                      "valueArc": false,
                      "thresholdArc": false
                    },
                    "displaySeriesName": false
                  }
                }
              },
              {
                "title": "Container restarts (1h)",
                "description": "Restarts across all containers in the last hour",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "sum(increase(k8s_container_restarts__restart_[1h]))",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
                    "max": 20,
                    "unit": "UNIT_NUMBER",
                    "decimal": 0,
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "thresholdBy": "THRESHOLD_BY_BACKGROUND",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "green"
                      },
                      {
                        "from": 1,
                        "color": "orange"
                      },
                      {
                        "from": 5,
                        "color": "red"
                      }
                    ],
                    "arcDisplay": {
                      "valueArc": false,
                      "thresholdArc": false
                    },
                    "displaySeriesName": false
                  }
                }
              }
            ]
          },
          {
            "height": 12,
            "widgets": [
              {
                "title": "Node CPU",
                "description": "Host CPU busy (1 - idle), agent host metrics",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "1 - avg(system_cpu_utilization_1{state=\"idle\", service_name=\"\"})",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
                    "max": 1,
                    "unit": "UNIT_PERCENT_ZERO_ONE",
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "green"
                      },
                      {
                        "from": 0.7,
                        "color": "orange"
                      },
                      {
                        "from": 0.9,
                        "color": "red"
                      }
                    ],
                    "arcDisplay": {
                      "valueArc": true,
                      "thresholdArc": true
                    },
                    "displaySeriesName": false
                  }
                }
              },
              {
                "title": "Node memory",
                "description": "Host memory used (excludes page cache)",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "sum(system_memory_utilization_1{state=\"used\", service_name=\"\"})",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
                    "max": 1,
                    "unit": "UNIT_PERCENT_ZERO_ONE",
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "green"
                      },
                      {
                        "from": 0.8,
                        "color": "orange"
                      },
                      {
                        "from": 0.9,
                        "color": "red"
                      }
                    ],
                    "arcDisplay": {
                      "valueArc": true,
                      "thresholdArc": true
                    },
                    "displaySeriesName": false
                  }
                }
              },
              {
                "title": "Node disk",
                "description": "Node filesystem used / capacity (kubelet)",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "max(k8s_node_filesystem_usage_By / k8s_node_filesystem_capacity_By)",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
                    "max": 1,
                    "unit": "UNIT_PERCENT_ZERO_ONE",
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "green"
                      },
                      {
                        "from": 0.8,
                        "color": "orange"
                      },
                      {
                        "from": 0.9,
                        "color": "red"
                      }
                    ],
                    "arcDisplay": {
                      "valueArc": true,
                      "thresholdArc": true
                    },
                    "displaySeriesName": false
                  }
                }
              },
              {
                "title": "Containers > 90% of memory limit",
                "description": "Working set over 90% of the container's limit: next in line for OOMKill",
                "definition": {
                  "gauge": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "count(max by (k8s_namespace_name, k8s_pod_name, k8s_container_name) (container_memory_working_set_By) / on (k8s_namespace_name, k8s_pod_name, k8s_container_name) max by (k8s_namespace_name, k8s_pod_name, k8s_container_name) (k8s_container_memory_limit_By) > 0.9) or vector(0)",
                        "aggregation": "AGGREGATION_LAST"
                      }
                    },
                    "min": 0,
                    "max": 10,
                    "unit": "UNIT_NUMBER",
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "thresholdBy": "THRESHOLD_BY_BACKGROUND",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "green"
                      },
                      {
                        "from": 1,
                        "color": "orange"
                      },
                      {
                        "from": 3,
                        "color": "red"
                      }
                    ],
                    "arcDisplay": {
                      "valueArc": false,
                      "thresholdArc": false
                    },
                    "displaySeriesName": false
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "options": {
          "name": "Workloads: where is the pressure?",
          "description": "Restarts and terminations first, then memory against limits (OOM risk), then CPU and network.",
          "color": "SECTION_PREDEFINED_COLOR_BLUE"
        },
        "rows": [
          {
            "height": 19,
            "widgets": [
              {
                "title": "Container restarts (per 5 min)",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "restarts",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum by (k8s_pod_name) (increase(k8s_container_restarts__restart_[5m])) > 0"
                          }
                        },
                        "seriesNameTemplate": "{{k8s_pod_name}}"
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_MAX",
                        "LEGEND_COLUMN_SUM"
                      ],
                      "placement": "LEGEND_PLACEMENT_BOTTOM"
                    }
                  }
                }
              },
              {
                "title": "Last termination reason",
                "description": "Containers whose previous run ended in OOMKilled, Error, ContainerCannotRun, DeadlineExceeded or Evicted. Unknown (node reboot) and Completed are left out.",
                "definition": {
                  "dataTable": {
                    "query": {
                      "metrics": {
                        "promqlQuery": "max by (k8s_namespace_name, k8s_pod_name, k8s_container_name, reason) (k8s_container_status_last_terminated_reason{reason=~\"OOMKilled|Error|ContainerCannotRun|DeadlineExceeded|Evicted\"}) == 1",
                        "promqlQueryType": "PROM_QL_QUERY_TYPE_INSTANT"
                      }
                    },
                    "resultsPerPage": 10,
                    "rowStyle": "ROW_STYLE_ONE_LINE",
                    "columns": [
                      {
                        "field": "k8s_namespace_name"
                      },
                      {
                        "field": "k8s_pod_name"
                      },
                      {
                        "field": "k8s_container_name"
                      },
                      {
                        "field": "reason"
                      }
                    ]
                  }
                }
              }
            ]
          },
          {
            "height": 19,
            "widgets": [
              {
                "title": "Memory: % of container limit (top 10)",
                "description": "Approaching 100% means an OOMKill is coming",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "memory vs limit",
                        "query": {
                          "metrics": {
                            "promqlQuery": "topk(10, max by (k8s_namespace_name, k8s_pod_name, k8s_container_name) (container_memory_working_set_By) / on (k8s_namespace_name, k8s_pod_name, k8s_container_name) max by (k8s_namespace_name, k8s_pod_name, k8s_container_name) (k8s_container_memory_limit_By))"
                          }
                        },
                        "unit": "UNIT_PERCENT_ZERO_ONE",
                        "seriesNameTemplate": "{{k8s_container_name}}",
                        "yAxisMin": 0,
                        "yAxisMax": 1
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_SIDE"
                    }
                  }
                }
              },
              {
                "title": "Memory working set by container",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "working set",
                        "query": {
                          "metrics": {
                            "promqlQuery": "topk(15, sum by (k8s_container_name) (container_memory_working_set_By{k8s_container_name!=\"\"}))"
                          }
                        },
                        "unit": "UNIT_BYTES_IEC",
                        "seriesNameTemplate": "{{k8s_container_name}}"
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_SIDE"
                    }
                  }
                }
              }
            ]
          },
          {
            "height": 19,
            "widgets": [
              {
                "title": "CPU by container (cores)",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "cpu",
                        "query": {
                          "metrics": {
                            "promqlQuery": "topk(15, sum by (k8s_container_name) (rate(container_cpu_time_s_total{k8s_container_name!=\"\"}[5m])))"
                          }
                        },
                        "decimal": 2,
                        "seriesNameTemplate": "{{k8s_container_name}}"
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_SIDE"
                    }
                  }
                }
              },
              {
                "title": "CPU throttling (% of periods)",
                "description": "Only containers with a CPU limit; sustained throttling shows up as latency",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "throttled",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum by (pod) (rate(container_cpu_cfs_throttled_periods_total[5m])) / sum by (pod) (rate(container_cpu_cfs_periods_total[5m]))"
                          }
                        },
                        "unit": "UNIT_PERCENT_ZERO_ONE",
                        "seriesNameTemplate": "{{pod}}"
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_BOTTOM"
                    }
                  }
                }
              },
              {
                "title": "Pod network (bytes/s, top 10)",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "network",
                        "query": {
                          "metrics": {
                            "promqlQuery": "topk(10, sum by (k8s_pod_name) (rate(k8s_pod_network_io_By_total[5m])))"
                          }
                        },
                        "unit": "UNIT_BYTES_IEC",
                        "seriesNameTemplate": "{{k8s_pod_name}}"
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_BOTTOM"
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "options": {
          "name": "Node",
          "description": "Single minikube node (6 vCPU, 10 GB). Load per CPU above 1.0 means runnable work is queuing.",
          "color": "SECTION_PREDEFINED_COLOR_PURPLE"
        },
        "rows": [
          {
            "height": 19,
            "widgets": [
              {
                "title": "CPU, memory, disk",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "CPU",
                        "query": {
                          "metrics": {
                            "promqlQuery": "1 - avg(system_cpu_utilization_1{state=\"idle\", service_name=\"\"})"
                          }
                        },
                        "unit": "UNIT_PERCENT_ZERO_ONE",
                        "yAxisMin": 0,
                        "yAxisMax": 1,
                        "seriesNameTemplate": "CPU"
                      },
                      {
                        "name": "Memory",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum(system_memory_utilization_1{state=\"used\", service_name=\"\"})"
                          }
                        },
                        "unit": "UNIT_PERCENT_ZERO_ONE",
                        "yAxisMin": 0,
                        "yAxisMax": 1,
                        "seriesNameTemplate": "Memory"
                      },
                      {
                        "name": "Disk",
                        "query": {
                          "metrics": {
                            "promqlQuery": "max(k8s_node_filesystem_usage_By / k8s_node_filesystem_capacity_By)"
                          }
                        },
                        "unit": "UNIT_PERCENT_ZERO_ONE",
                        "yAxisMin": 0,
                        "yAxisMax": 1,
                        "seriesNameTemplate": "Disk"
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_BOTTOM"
                    }
                  }
                }
              },
              {
                "title": "Load per CPU",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "1m",
                        "query": {
                          "metrics": {
                            "promqlQuery": "max(system_cpu_load_average_1m__thread_{service_name=\"\"}) / max(system_cpu_logical_count__cpu_{service_name=\"\"})"
                          }
                        },
                        "decimal": 2,
                        "seriesNameTemplate": "1m"
                      },
                      {
                        "name": "5m",
                        "query": {
                          "metrics": {
                            "promqlQuery": "max(system_cpu_load_average_5m__thread_{service_name=\"\"}) / max(system_cpu_logical_count__cpu_{service_name=\"\"})"
                          }
                        },
                        "decimal": 2,
                        "seriesNameTemplate": "5m"
                      },
                      {
                        "name": "15m",
                        "query": {
                          "metrics": {
                            "promqlQuery": "max(system_cpu_load_average_15m__thread_{service_name=\"\"}) / max(system_cpu_logical_count__cpu_{service_name=\"\"})"
                          }
                        },
                        "decimal": 2,
                        "seriesNameTemplate": "15m"
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_BOTTOM"
                    }
                  }
                }
              },
              {
                "title": "Node network and disk I/O (bytes/s)",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "network",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum by (direction) (rate(system_network_io_By_total{service_name=\"\"}[5m]))"
                          }
                        },
                        "unit": "UNIT_BYTES_IEC",
                        "seriesNameTemplate": "net {{direction}}"
                      },
                      {
                        "name": "disk",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum by (direction) (rate(system_disk_io_By_total{service_name=\"\"}[5m]))"
                          }
                        },
                        "unit": "UNIT_BYTES_IEC",
                        "seriesNameTemplate": "disk {{direction}}"
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_BOTTOM"
                    }
                  }
                }
              }
            ]
          }
        ]
      },
      {
        "options": {
          "name": "Telemetry pipeline (Coralogix agent)",
          "description": "Is observability itself healthy? Refused/failed data or a full export queue means blind spots elsewhere on this dashboard.",
          "color": "SECTION_PREDEFINED_COLOR_ORANGE"
        },
        "rows": [
          {
            "height": 19,
            "widgets": [
              {
                "title": "Received per signal (items/s)",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "spans",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum(rate(otelcol_receiver_accepted_spans_total[5m]))"
                          }
                        },
                        "seriesNameTemplate": "spans"
                      },
                      {
                        "name": "log records",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum(rate(otelcol_receiver_accepted_log_records_total[5m]))"
                          }
                        },
                        "seriesNameTemplate": "log records"
                      },
                      {
                        "name": "metric points",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum(rate(otelcol_receiver_accepted_metric_points_total[5m]))"
                          }
                        },
                        "seriesNameTemplate": "metric points"
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_AVG"
                      ],
                      "placement": "LEGEND_PLACEMENT_BOTTOM"
                    }
                  }
                }
              },
              {
                "title": "Refused / failed at receivers (items/s)",
                "description": "Should be flat zero",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "refused",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum(rate({__name__=~\"otelcol_receiver_refused_.*\"}[5m])) or vector(0)"
                          }
                        },
                        "seriesNameTemplate": "refused"
                      },
                      {
                        "name": "failed",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum(rate({__name__=~\"otelcol_receiver_failed_.*\"}[5m])) or vector(0)"
                          }
                        },
                        "seriesNameTemplate": "failed"
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_BOTTOM"
                    }
                  }
                }
              },
              {
                "title": "Export queue usage",
                "description": "Near 100% means Coralogix can't keep up or is unreachable, and data will be dropped",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "queue",
                        "query": {
                          "metrics": {
                            "promqlQuery": "max(otelcol_exporter_queue_size / otelcol_exporter_queue_capacity)"
                          }
                        },
                        "unit": "UNIT_PERCENT_ZERO_ONE",
                        "yAxisMin": 0,
                        "yAxisMax": 1,
                        "seriesNameTemplate": "queue"
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_MAX"
                      ],
                      "placement": "LEGEND_PLACEMENT_BOTTOM"
                    }
                  }
                }
              }
            ]
          },
          {
            "height": 19,
            "widgets": [
              {
                "title": "Noise dropped in the collector (log records/s)",
                "description": "coredns query logs, agent self-warnings, duplicate stdout/OTLP copies, nginx 2xx access lines",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "filtered",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum(rate(otelcol_processor_filter_logs_filtered_total[5m]))"
                          }
                        },
                        "seriesNameTemplate": "filtered"
                      }
                    ],
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_AVG"
                      ],
                      "placement": "LEGEND_PLACEMENT_BOTTOM"
                    }
                  }
                }
              },
              {
                "title": "Tail sampling: traces kept vs dropped (per s)",
                "description": "Kept: errors, >2s, browser-started, 10% of the rest",
                "definition": {
                  "lineChart": {
                    "queryDefinitions": [
                      {
                        "name": "traces",
                        "query": {
                          "metrics": {
                            "promqlQuery": "sum by (sampled) (rate(otelcol_processor_tail_sampling_global_count_traces_sampled_total[5m]))"
                          }
                        },
                        "seriesNameTemplate": "sampled={{sampled}}"
                      }
                    ],
                    "stackedLine": "STACKED_LINE_ABSOLUTE",
                    "legend": {
                      "isVisible": true,
                      "columns": [
                        "LEGEND_COLUMN_LAST",
                        "LEGEND_COLUMN_AVG"
                      ],
