diff --git a/src/frontend/utils/telemetry/CoralogixRum.ts b/src/frontend/utils/telemetry/CoralogixRum.ts
new file mode 100644
index 0000000..46f0377
--- /dev/null
+++ b/src/frontend/utils/telemetry/CoralogixRum.ts
@@ -0,0 +1,67 @@
+// Coralogix Real User Monitoring (RUM) for the demo shop.
+// Configured at runtime through window.ENV (see pages/_document.tsx); disabled when no key is set.
+
+import SessionGateway from '../../gateways/Session.gateway';
+
+const {
+  NEXT_PUBLIC_CORALOGIX_RUM_PUBLIC_KEY = '',
+  NEXT_PUBLIC_CORALOGIX_RUM_APPLICATION = 'Frontend',
+  NEXT_PUBLIC_CORALOGIX_RUM_DOMAIN = 'US2',
+  NEXT_PUBLIC_CORALOGIX_RUM_ENVIRONMENT = '',
+  NEXT_PUBLIC_CORALOGIX_RUM_VERSION = '',
+  IS_SYNTHETIC_REQUEST = '',
+} = typeof window !== 'undefined' ? window.ENV : {};
+
+export const isCoralogixRumEnabled = () =>
+  typeof window !== 'undefined' && NEXT_PUBLIC_CORALOGIX_RUM_PUBLIC_KEY !== '';
+
+// Same route templates the collector uses for http.route, in RUM's {param} style. Query strings
+// are dropped: they carry session IDs and whole shipping addresses, one blueprint per shopper.
+const blueprint = (url: string) =>
+  url
+    .replace(/[?#].*$/, '')
+    .replace(/\/api\/products\/[A-Z0-9]{10}(?=[/?#]|$)/, '/api/products/{productId}')
+    .replace(/\/product\/[A-Z0-9]{10}(?=[/?#]|$)/, '/product/{productId}')
+    .replace(/\/images\/products\/[^/?#]+/, '/images/products/{image}');
+
+const CoralogixRumInit = async () => {
+  if (!isCoralogixRumEnabled()) return;
+
+  const { CoralogixRum } = await import('@coralogix/browser');
+  if (CoralogixRum.isInited) return;
+
+  const session = SessionGateway.getSession();
+
+  CoralogixRum.init({
+    public_key: NEXT_PUBLIC_CORALOGIX_RUM_PUBLIC_KEY,
+    application: NEXT_PUBLIC_CORALOGIX_RUM_APPLICATION,
+    // Must match the version the source maps were uploaded with (set at image build time).
+    version: NEXT_PUBLIC_CORALOGIX_RUM_VERSION,
+    environment: NEXT_PUBLIC_CORALOGIX_RUM_ENVIRONMENT || undefined,
+    // Cast: the key comes from runtime config; the SDK validates it.
+    coralogixDomain: NEXT_PUBLIC_CORALOGIX_RUM_DOMAIN as 'US2',
+    // Adds W3C traceparent to same-origin fetch/XHR, linking RUM sessions to backend traces.
+    traceParentInHeader: { enabled: true },
+    urlBlueprinters: {
+      pageUrlBlueprinters: [blueprint],
+      networkUrlBlueprinters: [blueprint],
+    },
+    user_context: {
+      user_id: session.userId,
+      user_name: `shopper-${session.userId.slice(0, 8)}`,
+    },
+    labels: {
+      // The load generator's browser traffic is marked synthetic; keep it, but make it filterable.
+      synthetic: IS_SYNTHETIC_REQUEST === 'true' ? 'true' : 'false',
+      currency: session.currencyCode,
+    },
+    sessionRecordingConfig: {
+      enable: true,
+      autoStartSessionRecording: true,
+      recordConsoleEvents: true,
+      maskAllInputs: true,
+    },
+  });
+};
+
+export default CoralogixRumInit;
