+RUN npm install --no-save @coralogix/browser@4.2.0
 
 COPY ./src/frontend/components/ components/
 COPY ./src/frontend/gateways/ gateways/
@@ -29,6 +31,21 @@ COPY ./src/frontend/tsconfig.json tsconfig.json
 
 RUN npm run build
 
+# Upload browser source maps to Coralogix RUM, then delete them so the image never serves .map
+# files. The key comes in as a BuildKit secret (id=cx_sourcemap_key), so it never shows up in
+# build output or image history; without it the upload is skipped. RUM_VERSION must match the
+# SDK's runtime version, which the final stage bakes in as CORALOGIX_RUM_VERSION.
+ARG RUM_VERSION=3.1.0-cx
+ARG CORALOGIX_RUM_APPLICATION=Frontend
+ARG CORALOGIX_RUM_DOMAIN=US2
+RUN --mount=type=secret,id=cx_sourcemap_key \
+    if [ -s /run/secrets/cx_sourcemap_key ]; then \
+      npx -y @coralogix/rum-cli upload-source-maps \
+        -k "$(cat /run/secrets/cx_sourcemap_key)" -a "$CORALOGIX_RUM_APPLICATION" -v "$RUM_VERSION" \
+        -e "$CORALOGIX_RUM_DOMAIN" -f .next/static --override; \
+    else echo "No cx_sourcemap_key secret: skipping source map upload"; fi \
+ && find .next/static -name '*.map' -delete
+
 # -----------------------------------------------------------------------------
 
 FROM docker.io/library/node:25.9.0-slim@sha256:81db02c4b671288a03915da9534dbd54f96d0e7c24d80ccc54f5b36b2e684370 AS deps
@@ -55,6 +72,14 @@ COPY ./src/frontend/public/ public/

 COPY ./src/frontend/utils/telemetry/Instrumentation.js Instrumentation.js

+# Baked in so the browser SDK reports the same application/version the source maps were uploaded with.
+ARG RUM_VERSION=3.1.0-cx
+ARG CORALOGIX_RUM_APPLICATION=Frontend
+ARG CORALOGIX_RUM_DOMAIN=US2
+ENV CORALOGIX_RUM_VERSION=${RUM_VERSION} \
+    CORALOGIX_RUM_APPLICATION=${CORALOGIX_RUM_APPLICATION} \
+    CORALOGIX_RUM_DOMAIN=${CORALOGIX_RUM_DOMAIN}
+
 ARG FRONTEND_PORT=8080
 EXPOSE ${FRONTEND_PORT}
 
